<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live keyless ADS-B feeds, aircraft photos, and Esri/OSM map tiles over HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Googlebook OS exclusivity guardrail: require desktop App Widgets support -->
    <uses-feature
        android:name="android.software.app_widgets"
        android:required="true" />

    <!-- Keyboard + trackpad first on Googlebook; do not require touchscreen hardware -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkyWatch"
        android:usesCleartextTraffic="false">

        <!-- Googlebook OS Multi-Instance Desktop Windowing -->
        <property
            android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="standard"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultHeight="800dp"
                android:defaultWidth="1280dp"
                android:gravity="center"
                android:minHeight="420dp"
                android:minWidth="420dp" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Googlebook OS Live Radar Desktop App Widget -->
        <receiver
            android:name=".widget.SkyWatchWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.zakariaalnatour.skywatch.action.REFRESH_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/skywatch_widget_info" />
        </receiver>
    </application>

</manifest>
